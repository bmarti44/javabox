{
  "name": "@javabox/sdk",
  "version": "0.1.0",
  "description": "Run Java in the browser via Oracle Linux + JDK 21 in WASM (container2wasm)",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist/"
  },
  "devDependencies": {
    "typescript": "^5.4.0"
  },
  "keywords": [
    "java",
    "wasm",
    "webassembly",
    "container2wasm",
    "browser",
    "jdk",
    "javac"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/javabox"
  }
}
